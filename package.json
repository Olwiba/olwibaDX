{
  "name": "@olwiba/dx",
  "version": "0.0.28",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Developer experience tooling for the Olwiba ecosystem",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dx": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./eslint": {
      "import": "./dist/eslint.js",
      "types": "./dist/eslint.d.ts"
    },
    "./skills": {
      "import": "./dist/skills.js",
      "types": "./dist/skills.d.ts"
    },
    "./generate-previews": {
      "import": "./dist/generate-previews.js",
      "types": "./dist/generate-previews.d.ts"
    },
    "./ascii": {
      "import": "./dist/ascii/index.js",
      "types": "./dist/ascii/index.d.ts"
    },
    "./ascii-gif": {
      "import": "./dist/ascii-gif.js",
      "types": "./dist/ascii-gif.d.ts"
    },
    "./generate-assets": {
      "import": "./dist/generate-assets.js",
      "types": "./dist/generate-assets.d.ts"
    },
    "./env-check": {
      "import": "./dist/env-check.js",
      "types": "./dist/env-check.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "tsc": "tsc --noEmit",
    "web:build": "fumadocs-mdx && vite build",
    "web:dev": "fumadocs-mdx && vite dev",
    "start": "bun run server.ts",
    "types:check": "fumadocs-mdx && tsc --noEmit && tsc --noEmit -p tsconfig.site.json",
    "presets:generate": "bun scripts/generate-env-presets.ts"
  },
  "devDependencies": {
    "@olwiba/cn": "0.1.39",
    "@olwiba/docs": "0.1.45",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.154.8",
    "@tanstack/react-start": "1.154.8",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "fumadocs-core": "^16.4.7",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.4.7",
    "lucide-static": "^0.488.0",
    "next-themes": "^0.4.6",
    "puppeteer-core": "^25.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-pretty-code": "^0.14.0",
    "sharp": "^0.35.0",
    "shiki": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "puppeteer-core": ">=25.9.0",
    "@typescript-eslint/eslint-plugin": ">=8.0.0",
    "@typescript-eslint/parser": ">=8.0.0",
    "eslint-plugin-react-hooks": ">=5.0.0",
    "sharp": ">=0.35.0",
    "lucide-static": ">=0.400.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "lucide-static": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Olwiba/olwibaDX#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olwiba/olwibaDX"
  },
  "bugs": {
    "url": "https://github.com/Olwiba/olwibaDX/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "olwiba",
    "dx",
    "developer-experience",
    "vite-plugin",
    "tsup",
    "dev-banner",
    "ascii",
    "figlet",
    "eslint-config"
  ],
  "author": "Olwiba",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
